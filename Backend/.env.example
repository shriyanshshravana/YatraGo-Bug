# ==========================================
# YATRAGO BACKEND CONFIGURATION (.env.example)
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas Connection URI)
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/yatrago?retryWrites=true&w=majority

# JWT Authentication
# Use a long, unpredictable random string in production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=7d

# Email Provider Configuration
# OPTION A (RECOMMENDED FOR RENDER): Brevo HTTPS REST API (Port 443 - never blocked by cloud firewalls)
# Generate from Brevo Dashboard -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# OPTION B: SMTP (Nodemailer - works locally, but Render Free Tier blocks outbound SMTP ports 587/465)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
EMAIL_FROM="YatraGo Support <noreply@yatrago.com>"

# OTP Policy Configuration
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Cloudinary Storage Configuration (Profile Picture Uploads)
# Set these in your Render Dashboard -> Environment Variables
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

